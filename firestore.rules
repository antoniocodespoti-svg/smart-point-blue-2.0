rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Regole per la collezione dei profili utente
    match /users/{userId} {
      allow read, write: if true;
    }
    
    // Regole ricorsive per tutte le sottocollezioni degli utenti (tracked_foods, points_history, ecc.)
    match /users/{userId}/{allPaths=**} {
      allow read, write: if true;
    }

    // Regole per il test di connessione
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
